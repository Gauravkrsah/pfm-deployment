# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
# Current NVIDIA NIM model for grounded financial chat
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Low-latency NIM model for expense, income, and loan entry understanding
NVIDIA_NIM_ENTRY_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
# Optional override for hosted or self-hosted NIM endpoints
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional response budget for detailed grounded financial explanations
NVIDIA_NIM_MAX_TOKENS=1200

# Supabase Configuration (for password reset)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Server port
PORT=8000

# RAG Features:
# - Intelligent expense queries
# - Multi-category support
# - Context-aware responses
# - Smart categorization
